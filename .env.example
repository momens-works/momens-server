# 로컬 개발용 환경변수 예시입니다.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채웁니다.
#   cp .env.example .env
# .env 는 커밋하지 않습니다. 실제 secret 은 여기 두지 않습니다.

# 실행 프로필
SPRING_PROFILES_ACTIVE=local

# 애플리케이션 포트
SERVER_PORT=8080

# 데이터베이스 (로컬은 docker-compose 의 pgvector PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/momens
DATABASE_USERNAME=momens
DATABASE_PASSWORD=momens

# auth: HS256 access token 대칭키 (>=32바이트). 로컬용 임의 값으로 채웁니다. 실제 secret 은 커밋 금지.
MOMENS_AUTH_JWT_SECRET=change-me-local-dev-momens-auth-jwt-secret
# auth: Google ID token aud 허용 목록(web/android/ios client-id). 여러 값은 comma-separated.
MOMENS_AUTH_GOOGLE_AUDIENCES=local-google-client-id.apps.googleusercontent.com
# auth(web): 서버 주도 Authorization Code 플로우용 Google web client. client-secret 은 커밋 금지.
MOMENS_AUTH_GOOGLE_CLIENT_ID=local-web-client-id.apps.googleusercontent.com
MOMENS_AUTH_GOOGLE_CLIENT_SECRET=change-me-local-google-client-secret
MOMENS_AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# auth(web): 로그인 성공/실패 후 브라우저를 보낼 momens-fe URL.
MOMENS_AUTH_WEB_SUCCESS_REDIRECT_URI=http://localhost:3000/auth/success
MOMENS_AUTH_WEB_FAILURE_REDIRECT_URI=http://localhost:3000/auth/failure
# auth(dev): dev 전용 토큰 발급 엔드포인트(MOM-90) 호출자 제한 공유 시크릿. 로컬용 임의 값으로 채웁니다. 커밋 금지.
MOMENS_AUTH_DEV_TOKEN_SECRET=change-me-local-dev-token-secret

# Minsu Signal task draft: 기본은 비활성. 실제 Google 호출 시 ADC와 project 설정이 필요합니다.
MOMENS_MINSU_TASK_DRAFT_ENABLED=false
MOMENS_MINSU_LLM_PROVIDER=google
MOMENS_MINSU_LLM_MODEL=gemini-3.5-flash-lite
MOMENS_MINSU_LLM_TIMEOUT=8s
MOMENS_MINSU_LLM_GOOGLE_PROJECT=
MOMENS_MINSU_LLM_GOOGLE_LOCATION=global

# CORS: 브라우저에서 호출을 허용할 웹 프론트 origin. 여러 값은 comma-separated.
# env 이름은 레거시 momens-api 와 동일합니다(배포 설정 재사용).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# docker-compose PostgreSQL 초기화 값
POSTGRES_DB=momens
POSTGRES_USER=momens
POSTGRES_PASSWORD=momens
POSTGRES_PORT=5432

# MCP OAuth consent UI (환경별 FE의 /oauth/authorize 주소; 비어 있으면 인가 시작 불가)
MOMENS_MCP_CONSENT_URI=
